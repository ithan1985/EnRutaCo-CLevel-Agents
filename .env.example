# ── Modelos de lenguaje (Ollama) ─────────────────────────────
# «Rápido» responde en pocos segundos en CPU; «Profundo» razona mejor y es más lento.
LLM_MODEL_QUICK=qwen2.5:3b-instruct
LLM_MODEL_DEEP=qwen2.5:7b-instruct
# Con GPU de 12 GB o más puedes subir a: LLM_MODEL_DEEP=qwen2.5:14b-instruct
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.7
LLM_NUM_PREDICT=450
# En CPU el modo Rápido omite las notas del docente (evalúa, señales, trampa) para responder en la mitad de tiempo.
LLM_NOTES_IN_QUICK=0
LLM_KEEP_ALIVE=30m
PULL_ON_START=1

# ── Voces ────────────────────────────────────────────────────
# piper = CPU en tiempo real (voces de rhasspy/piper-voices en Hugging Face)
# xtts  = XTTS-v2 (coqui/XTTS-v2), voces más naturales, GPU recomendada. Requiere WITH_XTTS=1 y aceptar la licencia CPML.
# none  = sin voz
TTS_ENGINE=piper
WITH_XTTS=0
COQUI_TOS_AGREED=0

# ── Red ──────────────────────────────────────────────────────
WEB_PORT=8080
# HF_TOKEN=   (opcional; acelera las descargas de Hugging Face)
